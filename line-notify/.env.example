# 複製成 .env 後填入，.env 已被 .gitignore 忽略，不會進版控
# LINE Developers Console → 你的 Messaging API channel → Messaging API 分頁最下方
LINE_CHANNEL_ACCESS_TOKEN=

# 留空 = broadcast（推給所有加此 Bot 好友的人，不需額外設定）
# 填 userId = push（只推給指定對象，需要先架 webhook 取得 userId）
LINE_TO=

# 只有 serial_bridge.py 會用到；macOS 用 `ls /dev/cu.*` 查
SERIAL_PORT=
SERIAL_BAUD=115200

# ── MQTT broker（transport/receiver.py、run.py 讀這裡；車上的 sender.py 讀它旁邊的 sender.env，鍵名相同）──
# 區網測試（筆電上的 Mosquitto）全部留空即可：localhost:1883、不加密、不用帳密
# 雲端 broker：填位址與帳密，並設定 JETBOT_MQTT_TLS=1（埠號沒填時自動用 8883）
JETBOT_MQTT_HOST=
JETBOT_MQTT_PORT=
JETBOT_MQTT_USERNAME=
JETBOT_MQTT_PASSWORD=
JETBOT_MQTT_TLS=
# 只有自簽憑證（例如 transport/broker/secure/ 的本地加密 broker）才需要；雲端 broker 留空，用系統內建的 CA
JETBOT_MQTT_CA_CERTS=

# ── run.py ──
# 取消註解＝真的送出 LINE（會消耗免費額度）；保持註解＝dry-run
# JETBOT_SEND_LINE=1
# 訊息產生器：template／local（本地 LLM，預設）／cloud
# JETBOT_LLM_BACKEND=local
